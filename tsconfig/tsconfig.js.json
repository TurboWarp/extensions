{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // We handle emitting ourselves
    "noEmit": true,
    // Enable type warnings in JS
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "../node_modules/@turbowarp/types/types/scratch-vm-extension.d.ts",
    "../node_modules/@turbowarp/types/types/scratchx-extension.d.ts",
    "../globals.d.ts",
    "../extensions/**/*.js",
    "../website/**/*.js"
  ]
}
